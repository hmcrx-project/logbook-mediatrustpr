{
  "name": "logbook-mediatrustpr-backend",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:create": "wrangler d1 create logbook-mediatrustpr --location apac",
    "db:migrate:local": "wrangler d1 migrations apply logbook-mediatrustpr --local",
    "db:migrate:remote": "wrangler d1 migrations apply logbook-mediatrustpr --remote",
    "db:migrations:list": "wrangler d1 migrations list logbook-mediatrustpr"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
